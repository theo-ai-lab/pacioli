# ── dependencies ──
/node_modules
/.pnp
.pnp.*

# ── next.js / build output ──
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts

# ── workspace package build output (`npm run build -w packages/engine`) ──
packages/*/dist/
*.tgz

# ── testing / coverage ──
/coverage

# ── inspect eval logs (python) ──
__pycache__/
*.pyc
.venv/
/logs/

# ── env & secrets ──  (commit .env.example only)
.env*
!.env.example
*.pem

# ── vercel ──
.vercel

# ── deploy-time build provenance (scripts/predeploy.mjs) — committing it would let the recorded
#    sha drift from the commit it names; /api/version falls back honestly when it is absent ──
/lib/generated/

# ── os / editor / debug ──
.DS_Store
npm-debug.log*
*.log

# ── provenance firewall: RAW captured runs are personal data and never ship.
#    The committed public form is dataset/captured.public.jsonl — the redacted
#    projection emitted by `npm run capture:publish` (contract fields + a short
#    no-PII excerpt only), which is what makes the headline rate stranger-verifiable ──
dataset/captured.jsonl

# ── scratch screenshots (keep deliberate assets in public/) ──
/screenshots/

# ── fetched third-party benchmark data (MIT; fetched on demand, not redistributed) ──
bench/tau2/.cache/
