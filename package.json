{
  "name": "pacioli",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "predeploy": "node scripts/predeploy.mjs",
    "deploy": "vercel --prod",
    "postdeploy": "node scripts/postdeploy.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx lib/engine/eval.ts",
    "eval:snapshot": "tsx lib/engine/results-snapshot-cli.ts",
    "calibrate": "tsx lib/engine/calibrate-cli.ts",
    "eval:build": "tsx lib/engine/build-inspect-dataset.ts",
    "fuzz": "tsx lib/engine/fuzz-cli.ts",
    "audit": "tsx lib/report/audit-cli.ts",
    "verify:ledger": "tsx lib/store/verify-ledger-cli.ts",
    "drill:tamper": "tsx lib/store/tamper-drill-cli.ts",
    "reconcile": "tsx lib/engine/reconcile-cli.ts",
    "distill": "tsx lib/engine/reconcile-cli.ts --distill",
    "certify": "tsx lib/engine/reconcile-cli.ts --certify",
    "reconcile:pr": "tsx lib/adapters/pr-reconcile-cli.ts",
    "mcp": "tsx mcp/server.ts",
    "steward": "tsx agent/index.ts",
    "steward:demo": "tsx agent/index.ts",
    "steward:governed": "tsx agent/governor-demo.ts",
    "bench:tau2": "tsx bench/tau2/run.ts",
    "bench:perf": "tsx bench/perf.ts",
    "bench:ale": "tsx bench/ale/run.ts",
    "capture": "node dataset/capture/capture.mjs",
    "capture:validate": "node dataset/capture/validate.mjs",
    "capture:publish": "node dataset/capture/publish.mjs",
    "smoke:install": "bash scripts/install-smoke.sh"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.81",
    "@pacioli-app/engine": "*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ai": "^6.0.197",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
