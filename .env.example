# Pacioli — environment. Everything here is OPTIONAL: with no env at all, the app runs
# deterministic-only and the demo works fully end to end.

# ── The LLM judge (the abstained CLAIM_MISMATCH residual) ──────────────────────
# Hosted judge: get a key at https://console.anthropic.com/ (uses claude-haiku-4-5).
# Without it the "Run the live LLM judge" button reports the gated state.
ANTHROPIC_API_KEY=

# On-device judge (no key, nothing leaves your machine): run Ollama and pull a small
# model (`ollama pull qwen2.5:3b`). Defaults shown; uncomment to override.
# OLLAMA_URL=http://localhost:11434
# LOCAL_JUDGE_MODEL=qwen2.5:3b

# ── The optional HTTP API (POST /api/reconcile · GET /api/metrics) ─────────────
# Shared secret: when set, both routes require an `x-api-key` header, and judge
# selection over HTTP is unlocked (rate-limited, daily cost ceiling).
# PACIOLI_API_KEY=

# Durable receipt store via Node's BUILT-IN sqlite (zero added dependencies).
# Unset = bounded in-memory store (non-durable; /api/metrics shows which backend).
# PACIOLI_DB=./receipts.db
